import sys
import os
import re
import yt_dlp
from PyQt6.QtWidgets import (QApplication, QMainWindow, QWidget, 
                             QVBoxLayout, QHBoxLayout, QLineEdit, QComboBox, 
                             QPushButton, QProgressBar, QLabel, QMessageBox,
                             QFileDialog)
from PyQt6.QtCore import Qt, QThread, pyqtSignal

# 1. A Lógica de Download em Background
class DownloadThread(QThread):
    progress_signal = pyqtSignal(int)
    finished_signal = pyqtSignal(str)
    error_signal = pyqtSignal(str)

    def __init__(self, url, formato, qualidade, pasta_destino):
        super().__init__()
        self.url = url
        self.formato = formato
        self.qualidade = qualidade
        self.pasta_destino = pasta_destino

    def run(self):
        try:
            # Configurar o caminho final do ficheiro
            caminho_final = os.path.join(self.pasta_destino, '%(title)s.%(ext)s')

            ydl_opts = {
                'progress_hooks': [self.hook_progresso],
                'outtmpl': caminho_final,
                'quiet': True,
                'nocolor': True,
                'noplaylist': True
            }

            if self.formato == "MP3 (Áudio)":
                # Extrair o número do bitrate (ex: "320" de "320 kbps")
                kbps = self.qualidade.split(" ")[0]
                ydl_opts.update({
                    'format': 'bestaudio/best',
                    'postprocessors': [{
                        'key': 'FFmpegExtractAudio',
                        'preferredcodec': 'mp3',
                        'preferredquality': kbps,
                    }],
                })
            else:
                if self.qualidade == "Melhor disponível":
                    filtro_video = 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best'
                else:
                    # Extrair a resolução (ex: "1080" de "1080p")
                    res = self.qualidade.replace("p", "")
                    filtro_video = f'bestvideo[height<={res}][ext=mp4]+bestaudio[ext=m4a]/best[height<={res}][ext=mp4]/best'
                
                ydl_opts.update({
                    'format': filtro_video,
                })

            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                ydl.download([self.url])
            
            self.finished_signal.emit("Download concluído com sucesso!")
        
        except Exception as e:
            self.error_signal.emit(f"Erro no yt-dlp: {str(e)}")

    def hook_progresso(self, d):
        if d['status'] == 'downloading':
            p_str = d.get('_percent_str', '0%')
            p_str = re.sub(r'\x1b\[[0-9;]*m', '', p_str) 
            p_str = p_str.replace('%', '').strip()
            try:
                percentagem = int(float(p_str))
                self.progress_signal.emit(percentagem)
            except ValueError:
                pass


# 2. A Interface Gráfica
class ConversorApp(QMainWindow):
    def __init__(self):
        super().__init__()
        
        self.setWindowTitle("Conversor YT Premium")
        self.setFixedSize(500, 380) # Aumentei um pouco a janela
        
        # Pasta de destino por defeito (A pasta "Downloads" do Windows)
        self.pasta_atual = os.path.expanduser("~\\Downloads")
        
        widget_central = QWidget()
        layout = QVBoxLayout()
        layout.setSpacing(10)
        layout.setContentsMargins(20, 20, 20, 20)
        
        # URL
        self.label_url = QLabel("Link do Vídeo:")
        self.input_url = QLineEdit()
        self.input_url.setPlaceholderText("https://www.youtube.com/...")
        
        # Destino (Layout Horizontal para o botão e o caminho)
        self.label_destino = QLabel("Guardar em:")
        layout_destino = QHBoxLayout()
        self.btn_pasta = QPushButton("Escolher Pasta")
        self.btn_pasta.setFixedWidth(120)
        self.btn_pasta.clicked.connect(self.escolher_pasta)
        self.label_caminho = QLabel(self.pasta_atual)
        self.label_caminho.setStyleSheet("color: #666; font-size: 11px;")
        layout_destino.addWidget(self.btn_pasta)
        layout_destino.addWidget(self.label_caminho)
        
        # Formato e Qualidade
        self.label_formato = QLabel("Formato de Saída:")
        self.combo_formato = QComboBox()
        self.combo_formato.addItems(["MP3 (Áudio)", "MP4 (Vídeo)"])
        self.combo_formato.currentTextChanged.connect(self.atualizar_qualidades)
        
        self.label_qualidade = QLabel("Qualidade:")
        self.combo_qualidade = QComboBox()
        self.atualizar_qualidades("MP3 (Áudio)") # Carregar as qualidades iniciais
        
        # Progresso e Download
        self.progress_bar = QProgressBar()
        self.progress_bar.setValue(0)
        self.progress_bar.setAlignment(Qt.AlignmentFlag.AlignCenter)
        
        self.btn_download = QPushButton("Iniciar Download")
        self.btn_download.setMinimumHeight(40)
        self.btn_download.clicked.connect(self.iniciar_download)
        
        # Construir a UI
        layout.addWidget(self.label_url)
        layout.addWidget(self.input_url)
        
        layout.addWidget(self.label_destino)
        layout.addLayout(layout_destino)
        
        layout.addWidget(self.label_formato)
        layout.addWidget(self.combo_formato)
        layout.addWidget(self.label_qualidade)
        layout.addWidget(self.combo_qualidade)
        
        layout.addSpacing(10)
        layout.addWidget(self.progress_bar)
        layout.addWidget(self.btn_download)
        
        widget_central.setLayout(layout)
        self.setCentralWidget(widget_central)

    # 3. Gestão dos Eventos
    def escolher_pasta(self):
        pasta_selecionada = QFileDialog.getExistingDirectory(self, "Selecionar Pasta de Destino", self.pasta_atual)
        if pasta_selecionada:
            self.pasta_atual = pasta_selecionada
            self.label_caminho.setText(self.pasta_atual)

    def atualizar_qualidades(self, formato):
        self.combo_qualidade.clear()
        if formato == "MP3 (Áudio)":
            self.combo_qualidade.addItems(["320 kbps (Alta Qualidade)", "192 kbps (Qualidade Standard)", "128 kbps (Tamanho Reduzido)"])
        else:
            self.combo_qualidade.addItems(["1080p", "720p", "480p", "Melhor disponível"])

    def iniciar_download(self):
        url = self.input_url.text().strip()
        if not url:
            QMessageBox.warning(self, "Aviso", "Por favor, insere um link válido!")
            return
            
        formato = self.combo_formato.currentText()
        qualidade = self.combo_qualidade.currentText()
        
        self.btn_download.setEnabled(False)
        self.btn_download.setText("A transferir e a converter...")
        self.progress_bar.setValue(0)
        
        self.thread = DownloadThread(url, formato, qualidade, self.pasta_atual)
        self.thread.progress_signal.connect(self.atualizar_barra)
        self.thread.finished_signal.connect(self.download_concluido)
        self.thread.error_signal.connect(self.download_erro)
        self.thread.start()

    def atualizar_barra(self, valor):
        self.progress_bar.setValue(valor)

    def download_concluido(self, msg):
        self.progress_bar.setValue(100)
        QMessageBox.information(self, "Sucesso", f"{msg}\n\nGuardado em: {self.pasta_atual}")
        self.reset_ui()

    def download_erro(self, msg):
        QMessageBox.critical(self, "Erro", msg)
        self.reset_ui()
        
    def reset_ui(self):
        self.btn_download.setEnabled(True)
        self.btn_download.setText("Iniciar Download")
        self.progress_bar.setValue(0)
        self.input_url.clear()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    
    app.setStyleSheet("""
        QMainWindow { background-color: #f0f0f0; }
        QPushButton { background-color: #0078D7; color: white; border-radius: 5px; font-weight: bold; }
        QPushButton:hover { background-color: #005A9E; }
        QPushButton:disabled { background-color: #a0a0a0; }
        QLineEdit, QComboBox { padding: 6px; border: 1px solid #ccc; border-radius: 4px; }
        QLabel { font-weight: bold; margin-top: 5px; }
    """)
    
    janela = ConversorApp()
    janela.show()
    sys.exit(app.exec())
