# 1. Thread de Atualização Automática (Verifica updates ao abrir a app)
class UpdaterThread(QThread):
    finished_signal = pyqtSignal()

    def run(self):
        try:
            subprocess.check_call(
                [sys.executable, "-m", "pip", "install", "--upgrade", "yt-dlp", "--quiet"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL
            )
        except Exception:
            pass
        finally:
            self.finished_signal.emit()

# 2. Background Download Logic (Com Fallback Inteligente)
class DownloadThread(QThread):
    progress_signal = pyqtSignal(int)
    finished_signal = pyqtSignal(str)
    error_signal = pyqtSignal(str)

    def __init__(self, url, formato, qualidade, pasta_destino):
        super().__init__()
        self.url = url
        self.formato = formato
        self.qualidade = qualidade
        self.pasta_destino = pasta_destino

    def run(self):
        try:
            caminho_final = os.path.join(self.pasta_destino, '%(title)s.%(ext)s')

            ydl_opts = {
                'progress_hooks': [self.hook_progresso],
                'outtmpl': caminho_final,
                'quiet': True,
                'nocolor': True,
                'noplaylist': True
            }

            if self.formato == "MP3 (Audio)":
                kbps = self.qualidade.split(" ")[0]
                ydl_opts.update({
                    'format': 'bestaudio/best',
                    'postprocessors': [{
                        'key': 'FFmpegExtractAudio',
                        'preferredcodec': 'mp3',
                        'preferredquality': kbps,
                    }],
                })
            else:
                if self.qualidade == "Best available":
                    filtro_video = 'bestvideo+bestaudio/best'
                else:
                    res = re.search(r'\d+', self.qualidade).group()
                    filtro_video = f'bestvideo[height<={res}]+bestaudio/best[height<={res}]'
                
                ydl_opts.update({
                    'format': filtro_video,
                    'merge_output_format': 'mp4'
                })

            sucesso = False
            erro_final = ""

            # 1ª Tentativa: Sem cookies
            try:
                with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                    ydl.download([self.url])
                sucesso = True
                
            except Exception as e:
                erro_atual = str(e)
                
                # Fallback: Se o YouTube bloquear, tenta usar cookies do browser
                if "Sign in" in erro_atual or "bot" in erro_atual.lower() or "confirm" in erro_atual.lower():
                    browsers_para_testar = ['firefox', 'chrome', 'edge', 'brave', 'opera']
                    
                    for browser in browsers_para_testar:
                        try:
                            ydl_opts['cookiesfrombrowser'] = (browser,)
                            with yt_dlp.YoutubeDL(ydl_opts) as ydl:
                                ydl.download([self.url])
                            sucesso = True
                            break
                        except Exception:
                            continue
                            
                    if not sucesso:
                        erro_final = "YouTube is blocking the download.\nTip: Close your main browser completely and try again, or install Firefox."
                else:
                    erro_final = erro_atual

            if sucesso:
                self.finished_signal.emit("Download completed successfully!")
            else:
                self.error_signal.emit(f"Error: {erro_final}")
        
        except Exception as e:
            self.error_signal.emit(f"Critical error: {str(e)}")

    def hook_progresso(self, d):
        if d['status'] == 'downloading':
            p_str = d.get('_percent_str', '0%')
            p_str = re.sub(r'\x1b\[[0-9;]*m', '', p_str) 
            p_str = p_str.replace('%', '').strip()
            try:
                percentagem = int(float(p_str))
                self.progress_signal.emit(percentagem)
            except ValueError:
                pass


# 3. Graphical User Interface (GUI)
class ConversorApp(QMainWindow):
    def __init__(self):
        super().__init__()
        
        self.setWindowTitle("YT Premium Converter")
        self.setFixedSize(550, 480) 
        
        self.pasta_atual = os.path.expanduser("~\\Downloads")
        
        widget_central = QWidget()
        layout = QVBoxLayout()
        layout.setSpacing(15) 
        layout.setContentsMargins(30, 30, 30, 30)
        
        # URL Input
        self.label_url = QLabel("Video Link:")
        self.input_url = QLineEdit()
        self.input_url.setPlaceholderText(" Paste your link here (e.g., https://www.youtube.com/...)")
        
        # Destination Folder
        self.label_destino = QLabel("Save to:")
        layout_destino = QHBoxLayout()
        self.btn_pasta = QPushButton("Choose Folder")
        self.btn_pasta.setMinimumWidth(160) 
        self.btn_pasta.setProperty("class", "btn-secondary")
        self.btn_pasta.clicked.connect(self.escolher_pasta)
        
        self.label_caminho = QLabel(self.pasta_atual)
        self.label_caminho.setStyleSheet("color: #A0A0A0; font-size: 12px; font-weight: normal;")
        
        layout_destino.addWidget(self.btn_pasta)
        layout_destino.addWidget(self.label_caminho)
        
        # Format and Quality Selectors
        self.label_formato = QLabel("Output Format:")
        self.combo_formato = QComboBox()
        self.combo_formato.addItems(["MP3 (Audio)", "MP4 (Video)"])
        self.combo_formato.currentTextChanged.connect(self.atualizar_qualidades)
        
        self.label_qualidade = QLabel("Quality:")
        self.combo_qualidade = QComboBox()
        self.atualizar_qualidades("MP3 (Audio)")
        
        # Progress Bar and Download Button
        self.progress_bar = QProgressBar()
        self.progress_bar.setValue(0)
        self.progress_bar.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.progress_bar.setFixedHeight(25)
        
        self.btn_download = QPushButton("START DOWNLOAD")
        self.btn_download.setMinimumHeight(45)
        self.btn_download.setProperty("class", "btn-primary")
        self.btn_download.clicked.connect(self.iniciar_download)
        
        layout.addWidget(self.label_url)
        layout.addWidget(self.input_url)
        layout.addWidget(self.label_destino)
        layout.addLayout(layout_destino)
        layout.addWidget(self.label_formato)
        layout.addWidget(self.combo_formato)
        layout.addWidget(self.label_qualidade)
        layout.addWidget(self.combo_qualidade)
        layout.addSpacing(15)
        layout.addWidget(self.progress_bar)
        layout.addWidget(self.btn_download)
        
        widget_central.setLayout(layout)
        self.setCentralWidget(widget_central)

        # PROTEÇÃO PARA O PYINSTALLER: Ignora o update automático se for compilado
        if getattr(sys, 'frozen', False):
            pass # Estamos a correr como .exe, por isso não tentamos atualizar
        else:
            self.btn_download.setEnabled(False)
            self.btn_download.setText("CHECKING FOR UPDATES...")
            self.updater_thread = UpdaterThread()
            self.updater_thread.finished_signal.connect(self.update_concluido)
            self.updater_thread.start()

    # 4. Event Management
    def update_concluido(self):
        self.btn_download.setEnabled(True)
        self.btn_download.setText("START DOWNLOAD")

    def escolher_pasta(self):
        pasta_selecionada = QFileDialog.getExistingDirectory(self, "Select Destination Folder", self.pasta_atual)
        if pasta_selecionada:
            self.pasta_atual = pasta_selecionada
            self.label_caminho.setText(self.pasta_atual)

    def atualizar_qualidades(self, formato):
        self.combo_qualidade.clear()
        if formato == "MP3 (Audio)":
            self.combo_qualidade.addItems(["320 kbps (High Quality)", "192 kbps (Standard Quality)", "128 kbps (Reduced Size)"])
        else:
            self.combo_qualidade.addItems(["2160p (4K)", "1440p (2K)", "1080p", "720p", "480p", "Best available"])

    def iniciar_download(self):
        url = self.input_url.text().strip()
        if not url:
            QMessageBox.warning(self, "Warning", "Please enter a valid link!")
            return
            
        formato = self.combo_formato.currentText()
        qualidade = self.combo_qualidade.currentText()
        
        self.btn_download.setEnabled(False)
        self.btn_download.setText("DOWNLOADING & PROCESSING...")
        self.progress_bar.setValue(0)
        
        self.thread = DownloadThread(url, formato, qualidade, self.pasta_atual)
        self.thread.progress_signal.connect(self.atualizar_barra)
        self.thread.finished_signal.connect(self.download_concluido)
        self.thread.error_signal.connect(self.download_erro)
        self.thread.start()

    def atualizar_barra(self, valor):
        self.progress_bar.setValue(valor)

    def download_concluido(self, msg):
        self.progress_bar.setValue(100)
        QMessageBox.information(self, "Success", f"{msg}\n\nSaved to: {self.pasta_atual}")
        self.reset_ui()

    def download_erro(self, msg):
        QMessageBox.critical(self, "Error", msg)
        self.reset_ui()
        
    def reset_ui(self):
        self.btn_download.setEnabled(True)
        self.btn_download.setText("START DOWNLOAD")
        self.progress_bar.setValue(0)
        self.input_url.clear()


